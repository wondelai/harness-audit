{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run verify:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest run:*)",
      "Bash(node dist/cli.js:*)"
    ],
    "deny": [
      "Bash(npm publish:*)",
      "Bash(npm run release:publish:*)",
      "Bash(node scripts/publish.mjs:*)",
      "Bash(git push --follow-tags:*)",
      "Bash(git push --tags:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Edit(.github/workflows/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
